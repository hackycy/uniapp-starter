# 基础配置
VITE_APP_NAME = 'uniapp-starter'
# 保持大写英文名 + 下划线命名
VITE_APP_SHORT_NAME = ''
VITE_APP_ID = ''
VITE_APP_DESCRIPTION = 'A starter template for uniapp projects'
VITE_APP_PORT = 9000

# H5配置 (manifest.config.ts 里的 h5.router.base)
VITE_APP_PUBLIC_BASE = ./
# 跨域代理
VITE_APP_PROXY = [["/api","https://api.example.com"]]
# vconsole调试
VITE_DEVTOOL = false
VITE_VISUALIZER = false

# 开发接口配置
VITE_API_BASE_URL = '/api'
VITE_API_PATH = ''

# 微信小程序配置
VITE_WX_APPID = ''
# 公众号 / 服务号 Appid
VITE_OPENWX_APPID = ''