# 基础配置
VITE_APP_NAME = 'uniapp-starter'
VITE_APP_ID = ''
VITE_APP_DESCRIPTION = 'A starter template for uniapp projects'
VITE_APP_PORT = 9000

# H5配置 (manifest.config.ts 里的 h5.router.base)
VITE_APP_PUBLIC_BASE = /
VITE_APP_PROXY_ENABLED = true
VITE_DEVTOOL = true

# 开发接口配置
VITE_API_BASE_URL = 'https://api.example.com'
VITE_API_PATH = '/api'

# 微信小程序配置
VITE_WX_APPID = ''
# 公众号 / 服务号 Appid
VITE_OPENWX_APPID = ''